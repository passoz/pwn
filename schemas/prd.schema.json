{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piwerness.dev/schemas/prd.schema.json",
  "title": "Piwerness PRD Schema",
  "description": "Schema para Product Requirements Documents — documentos normativos validáveis",
  "type": "object",
  "required": ["meta", "id", "title", "status", "problem", "solution", "decisions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    
    "meta": {
      "type": "object",
      "required": ["version", "created_at", "author"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "grilling_depth": {
          "type": "string",
          "enum": ["light", "normal", "deep", "exhaustive"]
        }
      }
    },

    "id": {
      "type": "string",
      "pattern": "^PRD-\\d{4}$"
    },

    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },

    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "rejected", "superseded"]
    },

    "scenario": {
      "type": "string",
      "enum": ["greenfield", "brownfield"],
      "description": "Projeto novo ou alteração em existente"
    },

    "problem": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 20 },
        "context": { "type": "string" },
        "impact": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "solution": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 20 },
        "approach": { "type": "string" },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "reason_rejected"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "reason_rejected": { "type": "string" }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "level"],
            "properties": {
              "description": { "type": "string" },
              "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "mitigation": { "type": "string" }
            }
          }
        }
      }
    },

    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-\\d{3}$" },
          "statement": { "type": "string", "minLength": 10 },
          "rationale": { "type": "string" },
          "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "superseded"] },
          "made_at": { "type": "string", "format": "date-time" },
          "made_by": { "type": "string" },
          "supersedes": { "type": "string", "pattern": "^DEC-\\d{3}$" }
        }
      }
    },

    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^FR-\\d{3}$" },
          "type": { "type": "string", "enum": ["functional", "non-functional", "constraint"] },
          "statement": { "type": "string", "minLength": 10 },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "source": { "type": "string" },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "contact": { "type": "string" }
        }
      }
    },

    "scope": {
      "type": "object",
      "properties": {
        "in_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement"],
        "properties": {
          "statement": { "type": "string" },
          "validated": { "type": "boolean" }
        }
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["technical", "business", "external"] },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "resolved", "blocked"] }
        }
      }
    },

    "description_file": {
      "type": "string",
      "description": "Caminho para arquivo Markdown com descrição livre (opcional)"
    }
  }
}
