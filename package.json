{
  "name": "piwerness",
  "version": "0.1.0",
  "description": "Contract-governed agent harness framework for deterministic software engineering",
  "main": "src/cli.ts",
  "type": "module",
  "bin": {
    "pwn": "./bin/pwn.js"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun src/cli.ts validate",
    "check": "tsc --noEmit && bun test && bun src/cli.ts self-check && bun src/cli.ts validate"
  },
  "keywords": [
    "agent-harness",
    "contract-governed",
    "tdd",
    "piwerness",
    "ai-engineering"
  ],
  "author": "Google DeepMind Advanced Agentic Coding",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "typescript": "5"
  }
}
