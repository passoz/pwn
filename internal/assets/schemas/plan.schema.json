{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pwn.dev/schemas/plan.schema.json",
  "title": "PWN Plan Schema",
  "description": "Plano canonico de tarefas de um Work — fonte unica renderizada para o markdown v3",
  "type": "object",
  "required": ["work_id", "title", "components", "global_gates", "tasks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "work_id": { "type": "string", "pattern": "^\\d{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "meta": { "type": "object" },
    "status": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "root": { "type": "string", "description": "v3 execution-contract assurance column" },
          "regression": { "type": "string", "description": "v3 execution-contract assurance column" },
          "lint": { "type": "string", "description": "v3 execution-contract assurance column" },
          "build": { "type": "string", "description": "v3 execution-contract assurance column" },
          "security": { "type": "string", "description": "v3 execution-contract assurance column" },
          "dev": { "type": "string", "description": "v3 execution-contract assurance column" },
          "health": { "type": "string", "description": "v3 execution-contract assurance column" }
        }
      }
    },
    "global_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirement_id",
          "spec_reference",
          "contract_id",
          "components",
          "files",
          "implementation_files",
          "test_files",
          "red",
          "implementation_steps",
          "acceptance_criteria"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string", "pattern": "^(FR|QR|EC|SC|SOURCE)-\\d{3}$" },
          "spec_reference": { "type": "string", "minLength": 1 },
          "contract_id": { "type": "string", "minLength": 1 },
          "complexity": { "type": "string", "enum": ["low", "standard", "medium", "high", "critical", "architectural"] },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "behavior": { "type": "string" },
          "components": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "implementation_files": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
          "test_files": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
          "red": {
            "type": "object",
            "required": ["command", "description"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          },
          "implementation_steps": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["command", "description"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "description": { "type": "string" }
              }
            }
          },
          "visual": { "type": "string", "enum": ["N/A", "REQUIRED"] },
          "documentation": { "type": "string", "enum": ["N/A", "REQUIRED"] },
          "status": { "type": "string", "enum": ["pending", "done", "blocked"] }
        }
      }
    }
  }
}
