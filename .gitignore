node_modules/
# Runtime do agente; a exceção é o config do relay, versionado de propósito.
.pi/*
!.pi/remote-pi/
*.log

# Artefatos de runtime do harness (telemetria, eventos, aprendizados, sandboxes e fila AFK)
.pwn/metrics.jsonl
.pwn/RUN-*.jsonl
.pwn/learnings.json
.pwn/sandboxes/
.pwn/batch.json
.pwn/*.lock/
queue/review/
.pwn/decisions/

# Segredos e caches de veredicto: nunca versionar (a chave HMAC assina os gates)
.pwn/.verifier_key
.pwn/gate-cache/

# Configuração de roteamento pode conter API keys em texto claro
.pwn/routing.json

# Material de marketing (não versionado)
.marketing/

# Lixo de sessão de agente na raiz (transcrições e dumps exportados)
/continue.txt
/omp-session-*.html

# Variáveis de ambiente (podem conter segredos)
.env*
!.env.example

# Build Go
/bin/pwn
coverage.out
*.test
