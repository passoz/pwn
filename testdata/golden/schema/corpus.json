{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "name",
      "items",
      "mode",
      "when",
      "ref"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 5,
        "pattern": "^[a-z]+$"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "mode": {
        "type": "string",
        "enum": [
          "a",
          "b"
        ]
      },
      "extra": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "flag": {
            "type": "boolean"
          }
        }
      },
      "when": {
        "type": "string",
        "format": "date-time"
      },
      "ref": {
        "$ref": "#/definitions/positive"
      },
      "choice": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "definitions": {
      "positive": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "keywords": [
    "type",
    "properties",
    "required",
    "items",
    "additionalProperties",
    "enum",
    "pattern",
    "minLength",
    "maxLength",
    "minItems",
    "maxItems",
    "minimum",
    "maximum",
    "minProperties",
    "oneOf",
    "$ref",
    "format"
  ],
